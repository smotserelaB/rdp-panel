<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RdpPanel</RootNamespace>
    <AssemblyName>RdpPanel</AssemblyName>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.6.0</Version>
    <Product>RDP Panel</Product>
    <Authors>smotserela</Authors>
    <Copyright>© 2026 smotserela</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Web.Extensions" />
    <!-- Create these two DLLs with setup.bat (see README.md); in GitHub Actions the workflow does it -->
    <Reference Include="MSTSCLib">
      <HintPath>lib\MSTSCLib.dll</HintPath>
    </Reference>
    <Reference Include="AxMSTSCLib">
      <HintPath>lib\AxMSTSCLib.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- builds the two RDP DLLs into RdpPanel.exe, so the app is one single file -->
    <PackageReference Include="Costura.Fody" Version="5.7.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="docs\release-notes\*.md" LogicalName="ReleaseNotes.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
